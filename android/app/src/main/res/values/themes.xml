<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.SuperDentiste" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/teal_dark</item>
        <item name="android:statusBarColor">@color/teal_dark</item>
        <item name="android:navigationBarColor">@color/teal_light</item>
    </style>

    <style name="Theme.SuperDentiste.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/teal_dark</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SuperDentiste</item>
    </style>
</resources>
